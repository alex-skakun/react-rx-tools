{
  "name": "react-rx-tools",
  "version": "2.1.2",
  "sideEffects": false,
  "author": {
    "email": "alex.skakun@me.com",
    "name": "Aleksey Skakun",
    "url": "https://github.com/alex-skakun"
  },
  "repository": {
    "url": "git+https://github.com/alex-skakun/react-rx-tools.git"
  },
  "license": "MIT",
  "keywords": [
    "rxjs",
    "react",
    "tools",
    "observable",
    "reactive",
    "rx",
    "useObservable",
    "useTransitionObservable",
    "useSubject",
    "useSubscription",
    "useRxEvent",
    "useRxFactory",
    "useRxRef",
    "useRxMount",
    "useRxUnmount",
    "useRxCallback",
    "useExhaustCallback",
    "fromTransitionEnd",
    "fromAnimationEnd",
    "fromResizeObserver",
    "fromReportingObserver",
    "rxIntersectionObserver",
    "IntersectionObserver",
    "fromMediaQuery",
    "fromFileReader",
    "fromFileSelect",
    "catchErrorAndComplete",
    "catchErrorAndRetry",
    "distinctUntilRecordChanged"
  ],
  "scripts": {
    "start": "bun run ./demo/index.html",
    "pretest": "rm -rf _reports && mkdir _reports",
    "test": "bun test --isolate",
    "test:coverage": "bun run test -- --coverage",
    "posttest:coverage": "genhtml _reports/lcov.info --output-directory _reports/coverage/",
    "build": "bun run ./tools/index.ts build ./dist",
    "prerelease": "bun run build",
    "release": "bun run ./tools/index.ts publish ./dist"
  },
  "dependencies": {
    "react-cool-hooks": "^2.0.1",
    "react-cool-utils": "^2.0.1",
    "tslib": "^2.8.1",
    "value-guards": "^2.0.1"
  },
  "peerDependencies": {
    "@types/react": "18.x.x - 19.x.x",
    "@types/react-dom": "18.x.x - 19.x.x",
    "react": "18.x.x - 19.x.x",
    "react-dom": "18.x.x - 19.x.x",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.9.0",
    "@inquirer/prompts": "8.4.2",
    "@lcov-viewer/cli": "1.3.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "typescript": "5.9.3"
  }
}
